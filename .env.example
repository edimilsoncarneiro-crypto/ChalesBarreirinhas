# ========================================================
# CONFIGURAÇÕES DO BANCO DE DADOS POSTGRESQL
# ========================================================

# Opção 1: String de conexão completa (recomendada para Supabase, Neon, Render, Railway, etc.)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chales_barreirinhas

# Opção 2: Parâmetros individuais (padrão local)
PGHOST=localhost
PGPORT=5432
PGDATABASE=chales_barreirinhas
PGUSER=postgres
PGPASSWORD=postgres
PGSSL=false

# Porta do servidor Web
PORT=3000

